{
  "name": "goats",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=26.12.1"
  },
  "scripts": {
    "dev:server": "npm run dev -w apps/server",
    "dev:web": "npm run dev -w apps/web",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"apps/**/*.test.ts\"",
    "build": "npm run build -w apps/web",
    "start": "node apps/server/src/index.ts",
    "noir:setup": "node --env-file-if-exists=.env scripts/noir-setup.ts",
    "noir:smoke": "node --env-file-if-exists=.env scripts/noir-smoke.ts",
    "recheck-prices": "node scripts/recheck-prices.ts"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
