# Host configuration
PUBLIC_BASE_URL=
PORT=3000
DATA_DIR=./data
# Comma-separated funded Noir device hashes, one per demo slot
DEVICE_HASHES=

# Velo (Testnet project at https://www.velo-build.dev)
VELO_API_KEY=
VELO_WEBHOOK_SECRET=

# Noir signers used by the hosted app (Testnet only, never commit real values)
AGENT_SECRET=
MERCHANT_BASIC_SECRET=
MERCHANT_RECENT_SECRET=

# Local provisioning only. Never set this on the host.
NOIR_SETUP_OWNER_SECRET=
